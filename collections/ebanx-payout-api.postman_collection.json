  "info": {
    "_postman_id": "e9c3f20b-cdf1-49f7-8506-dbcbad13ff0a",
    "name": "EBANX Payout API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Send money from a merchant balance to a local bank account or e-wallet in EBANX's Latin American and emerging markets. Supports both local payouts (merchant pre-funds in local currency) and cross-border payouts (merchant deposits USD and EBANX converts to the payee's local currency), with bank transfers settled in up to two business days and e-wallets in roughly two minutes.\n\nContact Support:\n Name: EBANX Sales Engineering\n Email: sales.engineering@ebanx.com",
      "type": "text/plain"
    }
  }
