    "_postman_id": "ad4b04a8-10fd-4236-ba48-4a413da9d10d",
    "name": "EBANX Pay-in Direct API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Direct integration with EBANX to accept payments from customers in Latin America and other rising markets using local payment methods (Pix, Boleto, OXXO, SPEI, PSE, credit and debit cards, e-wallets, vouchers). The Direct API gives merchants full control over the checkout experience and is intended for high-conversion flows, subscriptions, and advanced payment scenarios.\n\nContact Support:\n Name: EBANX Sales Engineering\n Email: sales.engineering@ebanx.com",
      "type": "text/plain"
    }
  }
